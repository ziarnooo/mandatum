---
import Layout from '../layouts/Layout.astro';import Person from '../components/Person.astro';import foundation from '../data/foundation.json';import people from '../data/people.json';
---
<Layout title="About us" description="Meet the people behind The Mandatum Foundation and our commitment to retiring Special Operations members."><section class="page-hero"><div class="container"><p class="eyebrow">About us</p><h1>The Mandatum Foundation</h1><div class="lead">{foundation.overview.map(p=><p>{p}</p>)}</div></div></section><section class="section section-line"><div class="container split"><div><p class="eyebrow">The meaning behind our mark</p><h2>Laying down the trident.<br/>Looking forward.</h2><p>The trident has long been a powerful symbol of strength, resilience, and commitment.</p></div><div>{foundation.trident.map(p=><p class="muted">{p}</p>)}</div></div></section>{['Chief Executive Officer','Board of Directors','Board of Advisors'].map(group=><section class="section section-line"><div class="container"><p class="eyebrow">Our leadership</p><h2>{group}</h2>{group==='Board of Directors'&&<p class="lead">Our Board of Directors is composed of dedicated, retired Special Operations Forces veterans who bring firsthand experience and unwavering commitment to our mission.</p>}{group==='Board of Advisors'&&<p class="lead">Our Board of Advisors consists of distinguished private-sector professionals, carefully selected for their proven dedication to supporting our cause.</p>}<div class="people">{people.filter(p=>p.group===group).map(person=><Person person={person}/>)}</div></div></section>)}</Layout>
