---
import Layout from '../layouts/Layout.astro';import site from '../data/site.json';
---
<Layout title="Donate" description="Support retiring Special Operations members through The Mandatum Foundation. Donate with PayPal, Venmo, or by check."><section class="page-hero"><div class="container"><p class="eyebrow">Support their next mission</p><h1>They served us.<br/>Now stand with them.</h1><p class="lead">Our Fellows have dedicated their lives to protecting our freedom—now it’s our turn to support them. Your donation helps fill the gap in services tailored to retiring Special Operations members, ensuring they successfully transition from military service to the civilian workforce.</p></div></section><section class="section"><div class="container"><p class="eyebrow">Make a difference</p><h2>Choose how you give.</h2><div class="donation-grid"><article class="donation-card"><h2>PayPal</h2><p>Support the Foundation through PayPal.</p><a class="button" href={site.donations.paypal}>Donate with PayPal ↗</a></article><article class="donation-card"><h2>Venmo</h2><p>Find us at @themandatum on Venmo.</p><a class="button" href={site.donations.venmo}>Donate with Venmo ↗</a></article><article class="donation-card"><h2>Zeffy</h2>{site.donations.zeffy?<><p>Give through our Zeffy donation page.</p>{site.donations.zeffyQr&&<img src={site.donations.zeffyQr} alt="Scan to donate to The Mandatum Foundation with Zeffy" width="180" height="180" loading="lazy"/>}<a class="button" href={site.donations.zeffy}>Donate with Zeffy ↗</a></>:<><p>This giving option will be available soon.</p><p class="pending">Please use PayPal, Venmo, or give by check.</p></>}</article></div></div></section><section class="section section-line"><div class="container split"><div><p class="eyebrow">Other ways to donate</p><h2>A gift by check.<br/>A lasting difference.</h2></div><div><p>Make your check payable to The Mandatum Foundation and mail it to:</p><address class="address">The Mandatum Foundation<br/>{site.address.street}<br/>{site.address.city}, {site.address.state} {site.address.zip}</address><p class="small" style="margin-top:24px">The Mandatum Foundation is a 501(c)(3) nonprofit public charity.<br/>Tax ID: {site.taxId}</p><a class="text-link" href={`mailto:${site.email}`}>Questions about giving? Get in touch →</a></div></div></section></Layout>
