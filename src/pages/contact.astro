---
import Layout from '../layouts/Layout.astro';import site from '../data/site.json';
---
<Layout title="Contact" description="Get in touch with The Mandatum Foundation about becoming a Fellow, hosting an immersion, partnerships, or donations."><section class="page-hero"><div class="container"><p class="eyebrow">Start a conversation</p><h1>Your next chapter<br/>starts with a hello.</h1><p class="lead">Interested in a Fellowship, hosting a Fellow, or supporting our mission? We’d love to hear from you.</p></div></section><section class="section"><div class="container split"><div><h2>Let’s connect.</h2><p>Tell us a little about yourself and how we can help.</p><a class="button" href={`mailto:${site.email}`}>Email our team ↗</a><p class="small muted" style="margin-top:18px">Opens your email app. You can also copy the address below.</p></div><div class="contact-panel"><p class="eyebrow">Email</p><p class="lead"><a href={`mailto:${site.email}`}>{site.email}</a></p><p class="eyebrow">Mailing address</p><address class="address">The Mandatum Foundation<br/>{site.address.street}<br/>{site.address.city}, {site.address.state} {site.address.zip}</address></div></div></section></Layout>
