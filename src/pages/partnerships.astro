---
import Layout from '../layouts/Layout.astro';import partners from '../data/partners.json';
---
<Layout title="Partnerships" description="Meet the organizations helping Mandatum Fellows build meaningful civilian careers. Explore how to host a Fellow."><section class="page-hero"><div class="container"><p class="eyebrow">Stronger together</p><h1>Open a door.<br/>Change a future.</h1><p class="lead">Our partners connect exceptional military experience with new possibilities.</p><div class="actions"><a class="button" href="/contact">Become a partner →</a><a class="text-link" href="/faq">How hosting a Fellow works →</a></div></div></section><section class="section"><div class="container"><h2>Our partners</h2>{partners.map(partner=><article class="partner-row"><div class="partner-logo">{partner.image&&<img src={partner.image} alt={`${partner.title} logo`} width="500" height="300" loading="lazy"/>}</div><div><h2>{partner.title}</h2><p class="muted">{partner.text}</p>{partner.url&&<a class="text-link" href={partner.url}>Visit {partner.title} ↗</a>}</div></article>)}</div></section></Layout>
