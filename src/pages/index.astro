---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import pillars from '../data/pillars.json';
import foundation from '../data/foundation.json';
import events from '../data/events.json';
---
<Layout title="Providing the tools for success" hero>
<section class="hero" id="hero"><div class="container hero-grid"><div class="hero-copy"><h1>Providing the<br/>tools for success</h1><p>{site.intro}</p><div class="actions"><a class="button" href="/donate">Donate now</a><a class="button outline" href="/partnerships">Host a Fellow</a></div></div><div class="hero-image"><img src="/assets/hero.webp" srcset="/assets/hero-small.webp 700w, /assets/hero.webp 1400w" sizes="100vw" alt="A handshake connecting military service and civilian opportunity" width="1400" height="933" fetchpriority="high"/></div></div></section>
<section class="section original-mission"><div class="container"><h2>Our mission</h2><h3>Empowering Special Operations Members for Success Beyond Service</h3><p>{site.mission}</p><a class="mission-film" href="https://youtube.com/watch?v=M6fV7lvx42o" aria-label="Watch the Mandatum Foundation film on YouTube"><img src="/assets/mission-poster.webp" alt="Mandatum Foundation film" width="1200" height="675" loading="lazy"/><span>▶ <span class="film-label">Watch our story</span></span></a></div></section>
<section class="section original-vision"><div class="container"><h2>Our vision</h2><p class="lead">{site.vision}</p></div></section>
<section class="section original-values"><div class="container split"><div><h2>Our values</h2><img src="/assets/hero.webp" alt="Connection between military and civilian communities" width="1400" height="933" loading="lazy"/></div><div class="values">{foundation.values.map(value=><article><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></div></section>
<section class="section original-pillars"><div class="container"><div class="pillars">{pillars.map((pillar,i)=><article class="pillar"><span class="number">0{i+1}</span><div><p class="eyebrow">Pillar of support</p><h2>{pillar.title}</h2><p>{pillar.text}</p></div></article>)}</div></div></section>
<section class="section dark"><div class="container"><h2>Results you can see &amp; measure</h2><div class="metrics">{site.metrics.map(metric=><div class="metric"><strong>{metric.value}</strong><p>{metric.label}</p></div>)}</div><p class="small">{site.metricsNote}</p></div></section>
<section class="section"><div class="container"><h2>Come &amp; meet us</h2><details><summary>Past events</summary><div class="events">{events.map(event=><article class="event"><h3>{event.date}</h3><p>{event.name}</p></article>)}</div></details></div></section>
</Layout>
