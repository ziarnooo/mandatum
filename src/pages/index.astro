---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import pillars from '../data/pillars.json';
import foundation from '../data/foundation.json';
import events from '../data/events.json';
---
<Layout title="Purpose beyond service" hero>
<section class="hero" id="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">The next chapter starts here</p><h1>A life of service.<br/>A future of <em>purpose.</em></h1><p>Helping retiring Special Operations members find their footing, their community, and their next mission.</p><div class="actions"><a class="button" href="/donate">Donate now <span aria-hidden="true">↗</span></a><a class="button outline" href="/partnerships">Host a Fellow <span aria-hidden="true">→</span></a></div></div><div class="hero-image"><img src="/assets/hero.webp" srcset="/assets/hero-small.webp 700w, /assets/hero.webp 1400w" sizes="(max-width:760px) 100vw, 55vw" alt="A handshake connecting military service and civilian opportunity" width="1400" height="933" fetchpriority="high"/><span class="hero-caption">Experience. Connection. Opportunity.</span></div></div><div class="container hero-foot"><span>Built for the Special Operations community</span><span>With you. Beyond the uniform.</span></div></section>
<section class="section section-line"><div class="container split"><div><p class="eyebrow">Our mission</p><h2>Exceptional service.<br/>Meaningful futures.</h2><a class="text-link" href="/about-us">Get to know Mandatum →</a></div><div><p class="intro-copy">{site.intro}</p></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Three pillars. One purpose.</p><h2>A bridge to what comes next.</h2></div><a class="text-link" href="/faq">Explore the Fellowship →</a></div><div class="pillars">{pillars.map((pillar,i)=><article class="pillar"><span class="number">0{i+1}</span><h3>{pillar.title}</h3><p>{pillar.text}</p></article>)}</div></div></section>
<section class="section dark"><div class="container split"><div><p class="eyebrow">Our impact</p><h2>Results you can<br/>see and measure.</h2><p>{site.mission}</p></div><div><div class="metrics">{site.metrics.map(metric=><div class="metric"><strong>{metric.value}</strong><p>{metric.label}</p></div>)}</div><p class="small">{site.metricsNote}</p></div></div></section>
<section class="section"><div class="container split"><div><p class="eyebrow">What guides us</p><h2>Fellows first.<br/>Always.</h2><p class="muted">{site.vision}</p></div><div class="values">{foundation.values.map(value=><article><h3>{value.title}</h3><p class="small muted">{value.text}</p></article>)}</div></div></section>
<section class="section section-line"><div class="container"><p class="eyebrow">Our community in action</p><h2>Coming together for a purpose.</h2><p>Explore gatherings and events from the Foundation’s journey.</p><details><summary>Past events</summary><div class="events">{events.map(event=><article class="event"><h3>{event.date}</h3><p>{event.name}</p></article>)}</div></details></div></section>
</Layout>
