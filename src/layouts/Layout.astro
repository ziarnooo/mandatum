---
import '../styles/global.css';
import '../styles/original.css';
import Header from '../components/Header.astro';
import site from '../data/site.json';
const {title,description=site.mission,hero=false,schema=[]}=Astro.props;
const nav=[['/','Home'],['/about-us','About us'],['/partnerships','Partnerships'],['/testimonials','Testimonials'],['/contact','Contact'],['/faq','FAQ']];
const canonical=new URL(Astro.url.pathname,Astro.site).href;
const org={'@type':'NGO','@id':'https://www.themandatum.org/#organization',name:site.name,url:'https://www.themandatum.org',email:site.email,logo:'https://www.themandatum.org/assets/logo.svg',taxID:site.taxId,address:{'@type':'PostalAddress',streetAddress:site.address.street,addressLocality:site.address.city,addressRegion:site.address.state,postalCode:site.address.zip,addressCountry:'US'},sameAs:['https://www.linkedin.com/company/the-mandatum-foundation/','https://www.instagram.com/themandatumfoundation/']};
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><link rel="preload" href="/assets/neon.ttf" as="font" type="font/ttf" crossorigin/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | The Mandatum Foundation</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.png" type="image/png"/><meta name="theme-color" content="#132b36"/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | The Mandatum Foundation`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://www.themandatum.org/assets/hero.webp"/><meta name="twitter:card" content="summary_large_image"/><link rel="alternate" type="text/markdown" href={Astro.url.pathname==='/'?'/index.md':`${Astro.url.pathname}.md`} title="Markdown version"/>{hero&&<link rel="preload" as="image" href="/assets/hero.webp" imagesrcset="/assets/hero-small.webp 700w, /assets/hero.webp 1400w" imagesizes="100vw"/>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':[org,{'@type':'WebPage',name:title,description,url:canonical,isPartOf:{'@type':'WebSite',name:site.name,url:'https://www.themandatum.org'}},...schema]}).replace(/</g,'\u003c')}/></head><body><a class="skip" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><footer><div class="container footer-grid"><div><a class="footer-brand" href="/">THE MANDATUM<br/>FOUNDATION</a><p>Purpose beyond service.</p><p class="small">A 501(c)(3) nonprofit public charity.<br/>Tax ID: {site.taxId}</p></div><div><h2 class="eyebrow">Explore</h2><div class="footer-nav">{nav.filter(n=>n[0]!=='/').map(([url,label])=><a href={url}>{label}</a>)}<a href="/donate">Donate</a></div></div><div><h2 class="eyebrow">Get in touch</h2><a href={`mailto:${site.email}`}>{site.email}</a><address>{site.address.street}<br/>{site.address.city}, {site.address.state} {site.address.zip}</address><div class="social"><a href="https://www.linkedin.com/company/the-mandatum-foundation/">LinkedIn ↗</a><a href="https://www.instagram.com/themandatumfoundation/">Instagram ↗</a></div></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} The Mandatum Foundation</span><a href="/llms.txt">Information for AI assistants</a></div></footer></body></html>
